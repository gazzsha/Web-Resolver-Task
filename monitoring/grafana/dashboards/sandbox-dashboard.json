{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "web-resolver-sandbox",
  "title": "Web Resolver — Sandbox",
  "tags": ["sandbox", "web-resolver"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Executions/s (5m)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(rate(sandbox_execution_seconds_count{application=\"web-resolver-task\"}[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "decimals": 2}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Exec p95 (all)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(sandbox_execution_seconds_bucket{application=\"web-resolver-task\"}[5m])))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 15}]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "OOM killed (total)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(sandbox_oom_killed_total{application=\"web-resolver-task\"})", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Success ratio (OK verdicts)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"expr": "(sum(rate(sandbox_execution_seconds_count{application=\"web-resolver-task\",verdict=\"OK\"}[5m])) or vector(0)) / clamp_min(sum(rate(sandbox_execution_seconds_count{application=\"web-resolver-task\"}[5m])), 1)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "min": 0}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Execution latency p95 by language",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, language) (rate(sandbox_execution_seconds_bucket{application=\"web-resolver-task\"}[5m])))", "legendFormat": "p95 {{language}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Execution latency p50 / p95 (all)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(sandbox_execution_seconds_bucket{application=\"web-resolver-task\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(sandbox_execution_seconds_bucket{application=\"web-resolver-task\"}[5m])))", "legendFormat": "p95", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Verdict distribution (last 1h)",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum by (verdict) (increase(sandbox_execution_seconds_count{application=\"web-resolver-task\"}[1h]))", "legendFormat": "{{verdict}}", "refId": "A"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "pieType": "donut", "legend": {"showLegend": true, "placement": "right"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Verdict rate (5m)",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 12},
      "targets": [
        {"expr": "sum by (verdict) (rate(sandbox_execution_seconds_count{application=\"web-resolver-task\"}[5m]))", "legendFormat": "{{verdict}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Worker processing latency p50 / p95",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(worker_processing_seconds_bucket{application=\"web-resolver-task\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(worker_processing_seconds_bucket{application=\"web-resolver-task\"}[5m])))", "legendFormat": "p95", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Worker submissions by status (5m)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {"expr": "sum by (status) (rate(worker_submissions_total{application=\"web-resolver-task\"}[5m]))", "legendFormat": "{{status}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    }
  ]
}
