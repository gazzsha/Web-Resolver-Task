{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "web-resolver-kafka",
  "title": "Web Resolver — Kafka",
  "tags": ["kafka", "web-resolver"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Brokers up",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "kafka_brokers", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Topics",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "count(count by (topic) (kafka_topic_partitions))", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Consumer groups",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "count(count by (consumergroup) (kafka_consumergroup_current_offset))", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total consumer lag",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "sum(kafka_consumergroup_lag)", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 1000}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Consumer lag per group/topic",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag)", "refId": "A", "legendFormat": "{{consumergroup}} / {{topic}}"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Messages in per second (per topic)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "sum by (topic) (rate(kafka_topic_partition_current_offset[1m]))", "refId": "A", "legendFormat": "{{topic}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Partition count per topic",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum by (topic) (kafka_topic_partitions)", "refId": "A", "legendFormat": "{{topic}}"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Consumer-group commit rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "sum by (consumergroup) (rate(kafka_consumergroup_current_offset[1m]))", "refId": "A", "legendFormat": "{{consumergroup}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    }
  ]
}
