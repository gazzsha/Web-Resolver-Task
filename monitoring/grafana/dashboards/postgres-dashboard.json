{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "web-resolver-postgres",
  "title": "Web Resolver — PostgreSQL",
  "tags": ["postgres", "web-resolver"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Postgres up",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"expr": "pg_up", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active connections",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {"expr": "sum(pg_stat_activity_count{datname=\"web_resolver\"})", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connections used vs max",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(pg_stat_database_numbackends{datname=\"web_resolver\"}) / clamp_min(max(pg_settings_max_connections), 1)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "min": 0, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DB size",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"expr": "pg_database_size_bytes{datname=\"web_resolver\"}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Transactions/s (commit / rollback)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum(rate(pg_stat_database_xact_commit{datname=\"web_resolver\"}[5m]))", "legendFormat": "commit", "refId": "A"},
        {"expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"web_resolver\"}[5m]))", "legendFormat": "rollback", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cache hit ratio (5m)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "sum(rate(pg_stat_database_blks_hit{datname=\"web_resolver\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"web_resolver\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"web_resolver\"}[5m])), 1)", "legendFormat": "hit ratio", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "min": 0}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connections (backends)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum(pg_stat_database_numbackends{datname=\"web_resolver\"})", "legendFormat": "backends", "refId": "A"},
        {"expr": "max(pg_settings_max_connections)", "legendFormat": "max_connections", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Locks by mode",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "sum by (mode) (pg_locks_count{datname=\"web_resolver\"})", "legendFormat": "{{mode}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Deadlocks & conflicts rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"expr": "sum(rate(pg_stat_database_deadlocks{datname=\"web_resolver\"}[5m]))", "legendFormat": "deadlocks/s", "refId": "A"},
        {"expr": "sum(rate(pg_stat_database_conflicts{datname=\"web_resolver\"}[5m]))", "legendFormat": "conflicts/s", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tuples: returned / fetched / inserted / updated (5m)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {"expr": "sum(rate(pg_stat_database_tup_returned{datname=\"web_resolver\"}[5m]))", "legendFormat": "returned", "refId": "A"},
        {"expr": "sum(rate(pg_stat_database_tup_fetched{datname=\"web_resolver\"}[5m]))", "legendFormat": "fetched", "refId": "B"},
        {"expr": "sum(rate(pg_stat_database_tup_inserted{datname=\"web_resolver\"}[5m]))", "legendFormat": "inserted", "refId": "C"},
        {"expr": "sum(rate(pg_stat_database_tup_updated{datname=\"web_resolver\"}[5m]))", "legendFormat": "updated", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    }
  ]
}
