{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "web-resolver-postgres",
  "title": "Web Resolver — PostgreSQL",
  "tags": ["postgres", "web-resolver"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Postgres up",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "pg_up", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active connections",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(pg_stat_activity_count)", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connections / max",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(pg_stat_activity_count) / max(pg_settings_max_connections)", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.7},
              {"color": "red", "value": 0.85}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Database size",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "sum(pg_database_size_bytes{datname=\"web_resolver\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connections by state",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum by (state) (pg_stat_activity_count)", "refId": "A", "legendFormat": "{{state}}"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transactions per second (commit/rollback)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "sum(rate(pg_stat_database_xact_commit[1m]))", "refId": "A", "legendFormat": "commit"},
        {"expr": "sum(rate(pg_stat_database_xact_rollback[1m]))", "refId": "B", "legendFormat": "rollback"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Buffer cache hit ratio",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum(rate(pg_stat_database_blks_hit[1m])) / clamp_min(sum(rate(pg_stat_database_blks_hit[1m]) + rate(pg_stat_database_blks_read[1m])), 1)", "refId": "A", "legendFormat": "hit ratio"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "min": 0}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Locks (by mode)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "sum by (mode) (pg_locks_count)", "refId": "A", "legendFormat": "{{mode}}"}
      ]
    }
  ]
}
