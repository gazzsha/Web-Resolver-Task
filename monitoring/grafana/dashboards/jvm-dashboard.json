{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "web-resolver-jvm",
  "title": "Web Resolver — JVM",
  "tags": ["jvm", "web-resolver"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Process uptime",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "process_uptime_seconds{job=\"web-resolver-main\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Process CPU usage",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "process_cpu_usage{job=\"web-resolver-main\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "JVM live threads",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "jvm_threads_live_threads{job=\"web-resolver-main\"}", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Classes loaded",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "jvm_classes_loaded_classes{job=\"web-resolver-main\"}", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Heap memory used (by area)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum by (id) (jvm_memory_used_bytes{job=\"web-resolver-main\",area=\"heap\"})", "refId": "A", "legendFormat": "{{id}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Non-heap memory used (by area)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "sum by (id) (jvm_memory_used_bytes{job=\"web-resolver-main\",area=\"nonheap\"})", "refId": "A", "legendFormat": "{{id}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Heap usage ratio (used / max)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum(jvm_memory_used_bytes{job=\"web-resolver-main\",area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{job=\"web-resolver-main\",area=\"heap\"}), 1)", "refId": "A", "legendFormat": "heap usage"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "min": 0}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GC pause duration p95 (5m)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (action, le) (rate(jvm_gc_pause_seconds_bucket{job=\"web-resolver-main\"}[5m])))", "refId": "A", "legendFormat": "{{action}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GC pauses per second",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "targets": [
        {"expr": "sum by (action, cause) (rate(jvm_gc_pause_seconds_count{job=\"web-resolver-main\"}[1m]))", "refId": "A", "legendFormat": "{{action}} / {{cause}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    }
  ]
}
