# Web-Resolver-Task — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored.

# ─── Application ────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ─── PostgreSQL (consumed by docker-compose AND Spring) ─────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=web_resolver
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── GigaChat LLM (Phase 6) ─────────────────────────────────
# Get GIGACHAT_AUTH_KEY from https://developers.sber.ru/portal/products/gigachat-api
# It's the base64(client_id:client_secret) value.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_OAUTH_BASE_URL=https://ngw.devices.sberbank.ru:9443
GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru

# ─── Auth / JWT (Phase 4) ───────────────────────────────────
# Must be at least 32 random bytes (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-32-byte-random-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7
