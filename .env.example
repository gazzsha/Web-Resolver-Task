# Web-Resolver-Task — шаблон окружения. Скопируй в `.env` и заполни секреты.
# Читается docker-compose автоматически. Для `./gradlew :MainApplication:bootRun`
# экспортируй вручную:  set -a && . ./.env && set +a
# `.env` — gitignored; этот файл (.env.example) коммитится без секретов.

# ─── Application ────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ─── PostgreSQL (читается И docker-compose, И Spring) ───────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=web_resolver
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_WORKER_GROUP_ID=worker-group

# ─── GigaChat LLM (Phase 6) ─────────────────────────────────
# GIGACHAT_AUTH_KEY = base64(client_id:client_secret) из DevPortal Сбера.
# Пусто → ai-analyzer работает в rule-based fallback.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_OAUTH_BASE_URL=https://ngw.devices.sberbank.ru:9443
GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru
# true → AI-объяснения генерит LLM; false → только rule-based.
AI_EXPLAIN_VIA_LLM=false
# Опциональный ключ ChatGPT (worker/application.yml). Пусто → не используется.
AI_CHATGPT_API_KEY=

# ─── Auth / JWT (Phase 4) ───────────────────────────────────
# Не меньше 32 байт (`openssl rand -hex 32`). В проде обязательно ротировать.
JWT_SECRET=change-me-to-a-32-byte-random-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=web-resolver-task

# ─── Prometheus scraper (basic-auth к /actuator/prometheus) ─
PROMETHEUS_SCRAPER_USER=prometheus-scraper
PROMETHEUS_SCRAPER_PASSWORD=scraper-dev-pass

# ─── Monitoring UI ports ────────────────────────────────────
# Grafana внутри контейнера слушает 3000; наружу — на 3001,
# чтобы не конфликтовать с frontend (vite на 3000).
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
