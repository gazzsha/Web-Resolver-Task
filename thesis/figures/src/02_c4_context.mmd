    classDef system fill:#ddd,stroke:#000,stroke-width:2px,color:#111
    classDef external fill:#eee,stroke:#555,stroke-dasharray:4 3,color:#111

    S(("Студент")):::actor
    T(("Преподаватель")):::actor

