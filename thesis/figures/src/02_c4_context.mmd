        WS["Backend + Frontend"]:::system
    end

    G["GigaChat API<br/>(Sberbank)"]:::external
    DB["PostgreSQL"]:::external
    SB["Docker Sandbox"]:::external

    S -- "сдаёт решение" --> WS
    T -- "управляет каталогом" --> WS
    WS -- "AI-разбор кода" --> G
    WS -- "хранение задач,<br/>пользователей,<br/>результатов" --> DB
    WS -- "изолированный запуск<br/>пользовательского кода" --> SB
