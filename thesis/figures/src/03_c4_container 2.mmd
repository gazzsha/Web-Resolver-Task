flowchart TB
    classDef person fill:#08427B,stroke:#073B6F,color:#fff
    classDef container fill:#1168BD,stroke:#0E5BA6,color:#fff
    classDef datastore fill:#438DD5,stroke:#2E6295,color:#fff
    classDef external fill:#999999,stroke:#6B6B6B,color:#fff

    User["👤 Пользователь<br/>(Студент / Преподаватель)"]:::person

    subgraph System["Веб-сервис автоматизированной проверки"]
        Frontend["🌐 frontend<br/>React 18 + Vite + MUI<br/>+ Monaco Editor"]:::container
        Main["⚙️ MainApplication<br/>Spring Boot 3.5<br/>JWT, security, /actuator"]:::container
        TaskResolver["⚙️ task-resolver<br/>Spring Boot 3.5<br/>REST API"]:::container
        Worker["⚙️ worker<br/>Spring Boot 3.5<br/>Kafka consumer"]:::container
        Sandbox["🛡️ sandbox<br/>Spring Boot 3.5<br/>Docker-in-Docker"]:::container
        AIAnalyzer["🧠 ai-analyzer<br/>Spring Boot 3.5<br/>AST + LLM pipeline"]:::container
        ScenarioRunner["⚙️ scenario-runner<br/>Spring Boot 3.5<br/>Сценарные тесты"]:::container

        DB[("🗄️ PostgreSQL 16<br/>users, submissions,<br/>task_results, ai_analysis")]:::datastore
        Kafka[("📨 Apache Kafka<br/>task.submitted,<br/>task.completed")]:::datastore
    end

    GigaChat["☁️ GigaChat API"]:::external

    User -->|"HTTPS"| Frontend
    Frontend -->|"REST + JWT"| Main
    Frontend -->|"REST + JWT"| TaskResolver
    Main --> DB
    TaskResolver --> DB
    TaskResolver --> Kafka
    Kafka --> Worker
    Worker --> Sandbox
    Worker --> AIAnalyzer
    Worker --> ScenarioRunner
    Worker --> Kafka
    AIAnalyzer -->|"HTTPS + OAuth2"| GigaChat
    Worker --> DB
